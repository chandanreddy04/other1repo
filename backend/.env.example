# Database (local)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/made_it_home
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost/made_it_home
DB_SSL_REQUIRE=false

# Database (Neon — uncomment for cloud Postgres)
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-1.aws.neon.tech/made_it_home
# SYNC_DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/made_it_home
# DB_SSL_REQUIRE=true

# Database Pool (defaults shown — tune for production)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800

# Inngest (background task orchestration)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# JWT
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=made-it-home-photos

# Twilio (for SMS/OTP authentication)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890  # Must be E164 format

# Firebase
FIREBASE_CREDENTIALS_PATH=path/to/firebase-credentials.json

# App Settings
API_V1_STR=/api/v1
PROJECT_NAME=Made It Home
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Bugsnag (optional — error tracking)
BUGSNAG_API_KEY=

# Environment (development logs OTP to console, production sends SMS)
ENVIRONMENT=development
