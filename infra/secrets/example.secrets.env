# Template for per-environment secret values.
#
# Copy to <env>.secrets.env (dev.secrets.env / staging.secrets.env /
# production.secrets.env) and fill in real values. Those files are gitignored
# (the whole secrets/ dir is) — NEVER commit real values.
#
# Keys here are the SECRET entries from manifest.json. Static config
# (ENVIRONMENT, STORAGE_BACKEND, domains, ...) lives in the manifest, not
# here. After editing, run:  infra/aws/scripts/populate-secrets.sh <env>
#
# Regenerate this scaffold any time with:
#   python3 infra/secrets/manifest.py template

# --- Backend ---
SECRET_KEY=
DATABASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AWS_SNS_DELIVERY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_PRICE_ID_GROUP_MONTHLY=
STRIPE_PRICE_ID_GROUP_ANNUAL=
STRIPE_PRICE_ID_DAY_PASS=
BUGSNAG_API_KEY=

# --- Mobile (separate Bugsnag project from the backend) ---
MOBILE_BUGSNAG_API_KEY=
