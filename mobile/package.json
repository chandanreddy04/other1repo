{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "postinstall": "patch-package",
    "build:apk": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:release": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "eas-build-on-success": "node scripts/eas-build-on-success.js",
    "update:staging": "EXPO_PUBLIC_APP_ENV=staging eas update --environment preview --channel staging",
    "update:production": "EXPO_PUBLIC_APP_ENV=production eas update --environment production --channel production",
    "error-reporting:smoke": "node scripts/error-reporting-smoke.js"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "dependencies": {
    "@bugsnag/expo": "^54.0.0",
    "@bugsnag/plugin-expo-eas-sourcemaps": "^54.0.0",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "date-fns": "^4.1.0",
    "expo": "~54.0.33",
    "expo-application": "~7.0.8",
    "expo-background-fetch": "~14.0.9",
    "expo-background-task": "~1.0.10",
    "expo-battery": "~10.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.9",
    "expo-contacts": "~15.0.11",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "^14.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-intent-launcher": "~13.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-live-activity": "^0.4.2",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sms": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.16",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.81.5",
    "react-native-mask-input": "^1.2.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-worklets": "^0.5.1",
    "tailwindcss": "^3.4.17",
    "yup": "^1.7.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@bugsnag/cli": "^3.10.1",
    "@eslint/js": "^9.39.4",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "libphonenumber-js": "^1.12.12",
    "patch-package": "8.0.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.56.1"
  },
  "overrides": {
    "react-dom": "19.1.0",
    "shell-quote": "1.10.0",
    "postcss": "^8.5.25",
    "brace-expansion@5.0.6": "5.0.9",
    "metro": {
      "ws": "7.5.11"
    },
    "react-native": "0.81.5",
    "browserslist": "4.28.9",
    "fast-uri": "3.1.7",
    "nanoid": "3.3.18",
    "js-yaml@3.15.0": "3.15.2",
    "js-yaml@4.3.0": "4.3.2"
  },
  "private": true
}
