index 3571bc8..490e6fa 100644
--- a/node_modules/expo-live-activity/ios-files/Date+toTimerInterval.swift
+++ b/node_modules/expo-live-activity/ios-files/Date+toTimerInterval.swift
@@ -4,4 +4,22 @@ extension Date {
   static func toTimerInterval(miliseconds: Double) -> ClosedRange<Self> {
     now ... max(now, Date(timeIntervalSince1970: miliseconds / 1000))
   }
+
+  // Full-session interval for the fill bar: start → deadline, so the bar
+  // shows true session progress instead of restarting from "now of the last
+  // update". Clamped so the range stays valid whatever the clock says.
+  static func toFillInterval(
+    startMiliseconds: Double?, endMiliseconds: Double
+  ) -> ClosedRange<Self> {
+    let end = Date(timeIntervalSince1970: endMiliseconds / 1000)
+    let start = startMiliseconds.map { Date(timeIntervalSince1970: $0 / 1000) } ?? now
+    return min(start, end) ... end
+  }
+
+  // Count-up interval since the deadline, for the "how long overdue" hero
+  // timer. Capped at 24h — a live activity never survives that long anyway.
+  static func overdueInterval(endMiliseconds: Double) -> ClosedRange<Self> {
+    let end = Date(timeIntervalSince1970: endMiliseconds / 1000)
+    return min(now, end) ... end.addingTimeInterval(24 * 60 * 60)
+  }
 }
